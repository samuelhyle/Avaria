# Database
DATABASE_URL="postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/averianlabs?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Required in production (pins canonical origin; min length enforced in dev too).
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cron (Vercel Cron / external scheduler). Min 16 chars. Fails closed if unset.
CRON_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Coinbase Commerce (crypto checkout — being evaluated for launch)
COINBASE_COMMERCE_WEBHOOK_SECRET=""

# Public site URL (used in build/deploy scripts)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sendcloud
SENDCLOUD_PUBLIC_KEY=""
SENDCLOUD_SECRET_KEY=""
SENDCLOUD_WEBHOOK_SECRET=""

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""
SANITY_API_READ_TOKEN=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="averianlabs-media"
R2_PUBLIC_URL=""

# Meilisearch
MEILI_HOST=""
MEILI_API_KEY=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@averianlabs.eu"

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Sentry — SENTRY_DSN is used server-side, NEXT_PUBLIC_SENTRY_DSN by the browser SDK.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Legal identity surfaced in the footer. All NEXT_PUBLIC_LEGAL_* must be set
# before launch; placeholders ("FI-PENDING") are intentional until the real
# business ID and VAT ID are registered in the EU VIES.
NEXT_PUBLIC_LEGAL_COMPANY_NAME="AverianLabs Oy"
NEXT_PUBLIC_LEGAL_BUSINESS_ID="FI-PENDING"
NEXT_PUBLIC_LEGAL_VAT_ID="FI-PENDING"
NEXT_PUBLIC_LEGAL_ADDRESS_LINE1="Address pending"
NEXT_PUBLIC_LEGAL_ADDRESS_LINE2="Helsinki, Finland"
NEXT_PUBLIC_LEGAL_EMAIL="hello@averianlabs.eu"

# Upstash (rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Averia — AI research concierge (MiniMax API)
#
# Never commit a non-empty value for any of these. The lefthook pre-commit
# `secret-guard` hook rejects any diff that introduces one. On Vercel and
# Netlify, set `MINIMAX_API_KEY` in the project's environment-variable UI
# (Production / Preview / Branch scopes as appropriate).
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimax.io/v1"
MINIMAX_CHAT_MODEL="MiniMax-M3"
MINIMAX_EMBEDDING_MODEL="text-embedding-MiniMax-M3"
MINIMAX_EMBEDDING_DIMENSIONS="4096"
# Sanity webhook verification header (x-sanity-secret)
SANITY_WEBHOOK_SECRET=
