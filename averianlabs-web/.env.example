# Database
DATABASE_URL="postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/averianlabs?sslmode=require"
# The browser test suite mutates the database, so it needs an isolated one and
# refuses to run unless this matches DATABASE_URL exactly. The database name
# must be `averian_reliability` or `build`. Never point it at production.
TEST_DATABASE_URL="postgres://user:pass@ep-xxx.eu-central-1.aws.neon.tech/build?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
# Required in production (pins canonical origin; min length enforced in dev too).
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Cron (Vercel Cron / external scheduler). Min 16 chars. Fails closed if unset.
CRON_SECRET=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Coinbase Commerce (crypto checkout — being evaluated for launch)
COINBASE_COMMERCE_WEBHOOK_SECRET=""

# Telegram — crypto checkout. The bot issues the invoice, shows the wallet
# address and the exact amount, and tells the buyer when the payment lands.
# All optional: with them unset the crypto option is simply not offered.
# See docs/TELEGRAM_BOT_SETUP_2026-10-26.md for the full setup.
TELEGRAM_BOT_TOKEN=""
# The secret Telegram sends in X-Telegram-Bot-Api-Secret-Token.
# Min 16, max 256, and only A-Z a-z 0-9 _ - — Telegram rejects the whole
# setWebhook call otherwise. Generate with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=""
# Shared secret for bot -> site service calls. Min 16 chars.
TELEGRAM_INTERNAL_SECRET=""
# The team's chat that receives crypto invoice and settlement notifications.
# Negative for a group (-100...), positive for a private chat.
TELEGRAM_OPS_CHAT_ID=""
# The public @username of the bot, used to build the t.me deep link.
# Without the leading @.
TELEGRAM_BOT_USERNAME=""

# Crypto — receiving wallet and rate source.
# Per-chain addresses, e.g. "btc=bc1...,usdt_trc20=T...". Falls back to
# CRYPTO_WALLET_ADDRESS when a chain is not listed.
CRYPTO_WALLET_ADDRESSES=""
CRYPTO_WALLET_ADDRESS=""
# The chains the store accepts, e.g. "usdc_solana" or "btc,usdt_trc20".
CRYPTO_ENABLED_CHAINS=""
# Public price API used to lock the EUR rate when an invoice is issued.
CRYPTO_RATE_API_URL="https://api.coingecko.com/api/v3/simple/price"
# Fallback rates when the API is unreachable: "btc=60000,usdt_trc20=0.92".
# Leave empty to refuse invoices during an API outage instead of using a stale rate.
# USDC uses usdc_solana=<EUR per USDC>; USDC is USD-denominated, not EUR.
CRYPTO_FALLBACK_RATES=""
# Explorer keys for the deposit watcher. Bitcoin needs none.
ETHERSCAN_API_KEY=""
TRONGRID_API_KEY=""
# Solana mainnet RPC for native USDC. A dedicated endpoint is recommended for
# sustained production traffic; the public endpoint works for initial checks.
SOLANA_RPC_URL="https://api.mainnet.solana.com"

# Public site URL (used in build/deploy scripts)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Sendcloud
SENDCLOUD_PUBLIC_KEY=""
SENDCLOUD_SECRET_KEY=""
SENDCLOUD_WEBHOOK_SECRET=""

# Sanity
NEXT_PUBLIC_SANITY_PROJECT_ID=""
NEXT_PUBLIC_SANITY_DATASET="production"
SANITY_API_TOKEN=""
SANITY_API_READ_TOKEN=""

# Cloudflare R2
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="averianlabs-media"
R2_PUBLIC_URL=""

# Meilisearch
MEILI_HOST=""
MEILI_API_KEY=""

# Resend
RESEND_API_KEY=""
RESEND_FROM_EMAIL="orders@averianlabs.eu"

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"

# Sentry — SENTRY_DSN is used server-side, NEXT_PUBLIC_SENTRY_DSN by the browser SDK.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# Legal identity surfaced in the footer. All NEXT_PUBLIC_LEGAL_* must be set
# before launch; placeholders ("FI-PENDING") are intentional until the real
# business ID and VAT ID are registered in the EU VIES.
NEXT_PUBLIC_LEGAL_COMPANY_NAME="AverianLabs Oy"
NEXT_PUBLIC_LEGAL_BUSINESS_ID="FI-PENDING"
NEXT_PUBLIC_LEGAL_VAT_ID="FI-PENDING"
NEXT_PUBLIC_LEGAL_ADDRESS_LINE1="Address pending"
NEXT_PUBLIC_LEGAL_ADDRESS_LINE2="Helsinki, Finland"
NEXT_PUBLIC_LEGAL_EMAIL="hello@averianlabs.eu"

# Upstash (rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Averia — AI research concierge (MiniMax API)
#
# Never commit a non-empty value for any of these. The lefthook pre-commit
# `secret-guard` hook rejects any diff that introduces one. On Vercel and
# Netlify, set `MINIMAX_API_KEY` in the project's environment-variable UI
# (Production / Preview / Branch scopes as appropriate).
MINIMAX_API_KEY=""
MINIMAX_BASE_URL="https://api.minimax.io/v1"
MINIMAX_CHAT_MODEL="MiniMax-M3.1-Flash"
MINIMAX_EMBEDDING_MODEL="text-embedding-MiniMax-M3"
MINIMAX_EMBEDDING_DIMENSIONS=""
# Sanity webhook verification header (x-sanity-secret)
SANITY_WEBHOOK_SECRET=

# Explicit no-goods EUR 1.50 checkout fixture (review site only).
CHECKOUT_TEST_PRODUCT_ENABLED=false

# The checkout fixture is a payment test, not a product: it has no goods, no
# batch and no certificate. The storefront leaves it out of the catalogue, the
# search, the sitemap and the recommendations. Set this to "true" to put it
# back while testing the payment path.
CHECKOUT_FIXTURE_IN_STOREFRONT=false
