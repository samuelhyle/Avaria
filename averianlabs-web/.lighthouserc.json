{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000/en",
        "http://localhost:3000/fi/shop",
        "http://localhost:3000/en/shop/bpc-157",
        "http://localhost:3000/fi/peptide-calculator",
        "http://localhost:3000/en/assistant",
        "http://localhost:3000/fi/community",
        "http://localhost:3000/en/documents"
      ],
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready in",
      "startServerReadyTimeout": 120000,
      "numberOfRuns": 3,
      "settings": {
        "skipAudits": ["uses-http2", "is-on-https"]
      }
    },
    "assert": {
      "assertMatrix": true,
      "assertions": {
        "categories:performance": [
          "error",
          {
            "minScore": 0.7
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.85
          }
        ],
        "unused-javascript": "warn",
        "unused-css-rules": "warn",
        "uses-text-compression": "off",
        "uses-rel-preconnect": "off",
        "legacy-javascript": "off",
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.95
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/baseline"
    }
  }
}
