{
  "name": "averianlabs-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "pnpm env:check && next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:a11y": "node scripts/a11y-smoke.mjs",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --grep @visual",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "env:check": "tsx scripts/check-env.ts",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:lh": "lhci autorun",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx db/seed.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "legal:check": "tsx scripts/check-legal-placeholders.ts",
    "sanity:seed-glossary": "tsx scripts/seed-glossary.ts",
    "ai:index": "tsx --env-file-if-exists=.env.local scripts/ai-index.ts",
    "ai:eval": "tsx --env-file-if-exists=.env.local scripts/ai-eval.ts",
    "studio": "sanity dev --project-path sanity",
    "build:demo": "./scripts/build-demo.sh",
    "postinstall": "lefthook install || true",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:deployment": "node --test scripts/legacy-baseline.test.mjs",
    "check:i18n:usage": "node scripts/check-i18n-usage.mjs",
    "release:check": "pnpm env:check && pnpm legal:check && tsx scripts/check-release.ts",
    "ai:eval:research": "tsx scripts/ai-research-eval.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@aws-sdk/client-s3": "^3.1150.0",
    "@aws-sdk/s3-request-presigner": "^3.1150.0",
    "@hookform/resolvers": "^3.10.0",
    "@huggingface/transformers": "^4.2.0",
    "@radix-ui/react-accordion": "^1.2.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.0.4",
    "@sanity/client": "^7.26.2",
    "@sanity/image-url": "^1.1.0",
    "@sentry/nextjs": "^10.74.0",
    "@stripe/react-stripe-js": "^6.10.0",
    "@stripe/stripe-js": "^9.16.0",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "argon2": "^0.41.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.0.4",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.5.2",
    "geist": "^1.3.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.471.0",
    "meilisearch": "^0.45.0",
    "motion": "^11.15.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.0.0-beta.10",
    "next-themes": "^0.4.4",
    "postgres": "^3.4.5",
    "posthog-js": "^1.438.9",
    "postprocessing": "^6.36.4",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-hook-form": "^7.54.2",
    "react-markdown": "^10.1.0",
    "react-pdf": "^9.2.1",
    "remark-gfm": "^4.0.1",
    "resend": "^4.0.1",
    "sonner": "^1.7.1",
    "stripe": "^17.5.0",
    "tailwind-merge": "^2.6.0",
    "three": "^0.176.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@biomejs/biome": "^1.9.4",
    "@lhci/cli": "^0.15.1",
    "@netlify/blobs": "11.1.3",
    "@playwright/test": "^1.49.1",
    "@sanity/vision": "^3.99.0",
    "@tailwindcss/postcss": "^4.0.0-beta.7",
    "@types/node": "^22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "@types/three": "^0.176.0",
    "axe-core": "4.10.2",
    "drizzle-kit": "^0.31.10",
    "happy-dom": "^15.11.7",
    "lefthook": "^1.11.13",
    "next-sanity": "^9.12.3",
    "postcss": "^8.5.28",
    "sanity": "^3.99.0",
    "tailwindcss": "^4.0.0-beta.7",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@biomejs/biome",
      "@parcel/watcher",
      "@swc/core",
      "esbuild",
      "sharp",
      "onnxruntime-node",
      "protobufjs"
    ],
    "overrides": {
      "postcss": "8.5.28",
      "shell-quote": "1.11.0",
      "sharp": "0.35.5",
      "adm-zip": "0.6.1",
      "brace-expansion@5": "5.0.12",
      "fast-uri@3": "3.1.8",
      "source-map-js": "1.2.2",
      "dompurify": "3.4.16",
      "@huggingface/transformers>onnxruntime-node": "1.23.2"
    }
  }
}
