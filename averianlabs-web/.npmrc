node-linker=isolated
prefer-frozen-lockfile=true
strict-peer-dependencies=false
auto-install-peers=true
# Side-effects cache makes repeated installs in CI / Docker ~3x faster.
side-effects-cache=true
# A dependency's build script is not a reason to fail an install. pnpm 10.16
# and later refuse an install whose build scripts are not approved, and the
# refusal has nothing to do with the code being deployed.
strict-dep-builds=false
# react-pdf resolves its bundled PDF worker from the app.
public-hoist-pattern[]=pdfjs-dist
